# Local development values only. Copy to .env and change as appropriate.
# Used by the shared local PostgreSQL instance. DEV always connects to the
# separate vivatflow_dev database, never to this DEMO database.
POSTGRES_DB=tsdt
POSTGRES_USER=tsdt
POSTGRES_PASSWORD=change-me-for-local-development
# PostgreSQL is shared by DEMO and DEV on port 5432. The normal DEV workflow
# creates only the separate vivatflow_dev logical database when it is absent.
# Set these as environment variables before starting the API; do not commit real values.
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=vivatflow_dev;Username=tsdt;Password=change-me-for-local-development
# BootstrapAdmin__Email=admin@example.test
# BootstrapAdmin__FullName=Local Bootstrap Administrator
# BootstrapAdmin__Password=Replace-with-a-unique-local-password
